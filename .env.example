# Copy to .env and fill in. Never commit .env.
TELNYX_API_KEY=
LLM_BASE_URL=https://api.telnyx.com/v2/ai/openai
LLM_MODEL=
# Embeddings for hybrid search (#30), e.g. thenlper/gte-large
LLM_EMBED_MODEL=
# Postgres (docker compose): Temporal's database, and the diagnosis checkpoints (#51)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Knowledge graph: the compose container, or AuraDB Free for the demo (neo4j+s://...)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
CHECKPOINT_DB_URL=postgresql://<user>:<password>@localhost:5432/postgres
TEMPORAL_HOST=localhost:7233
API_KEYS=
